{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ep-cards.local/schema/card.schema.json",
  "title": "EP Knowledge Card & Deck Schema",
  "description": "Schema for Cardiac Electrophysiology (EP) e-ink knowledge cards targeting TRMNL / Terminus multi-screen plugins.",
  "oneOf": [
    { "$ref": "#/$defs/deck" },
    { "$ref": "#/$defs/card" }
  ],
  "$defs": {
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "deck_id", "generated_at", "cards"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "deck_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/card" }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "schema_version",
        "category",
        "difficulty",
        "tags",
        "abbreviations",
        "content",
        "layout",
        "diagram",
        "evidence",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$",
          "minLength": 5,
          "maxLength": 64,
          "description": "Kebab-case unique card identifier, e.g. svt-typical-avnrt-short-va."
        },
        "schema_version": { "const": "1.0.0" },
        "category": {
          "type": "string",
          "enum": [
            "conduction_anatomy",
            "basic_intervals",
            "ep_mechanisms",
            "svt_triage",
            "wpw_preexcitation",
            "pacing_maneuvers",
            "wide_qrs_vt",
            "ablation_safety"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": ["intro", "bridge"]
        },
        "tags": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        },
        "abbreviations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["whitelisted", "defined_in_card"],
          "properties": {
            "whitelisted": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "AVNRT",
                  "AVRT",
                  "AT",
                  "SVT",
                  "WPW",
                  "ECG",
                  "AH",
                  "HV",
                  "VA",
                  "RP",
                  "PR",
                  "QRS",
                  "ERP",
                  "CS",
                  "His",
                  "PVC",
                  "PAC",
                  "RBBB",
                  "LBBB",
                  "VT",
                  "AF",
                  "SA",
                  "AVN"
                ]
              },
              "uniqueItems": true
            },
            "defined_in_card": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["abbr", "zh", "en"],
                "properties": {
                  "abbr": { "type": "string", "minLength": 2, "maxLength": 16 },
                  "zh": { "type": "string", "minLength": 1, "maxLength": 32 },
                  "en": { "type": "string", "minLength": 1, "maxLength": 64 }
                }
              }
            }
          }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh"],
          "properties": {
            "zh": { "$ref": "#/$defs/localized_content_zh" },
            "en": { "$ref": "#/$defs/localized_content_en" }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred_template", "diagram_aspect_ratio", "text_density"],
          "properties": {
            "preferred_template": {
              "type": "string",
              "enum": [
                "split_left",
                "split_right",
                "top_banner",
                "compare_two",
                "focus_concept"
              ]
            },
            "diagram_aspect_ratio": {
              "type": "string",
              "enum": [
                "square_1_1",
                "portrait_4_5",
                "landscape_4_3",
                "wide_2_1",
                "ultrawide_3_1",
                "none"
              ]
            },
            "text_density": {
              "type": "string",
              "enum": ["compact", "balanced", "rich_x_only"]
            }
          }
        },
        "diagram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "kind",
            "production_route",
            "svg_id",
            "visual_goal",
            "must_show_elements",
            "labels",
            "semantic_color_plan",
            "medical_accuracy_checks"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "kind": {
              "type": "string",
              "enum": [
                "ecg_egm_waveform",
                "ladder_diagram",
                "anatomy_sketch",
                "reentry_circuit",
                "comparison_pair",
                "none"
              ]
            },
            "production_route": {
              "type": "string",
              "enum": [
                "code_generated_svg",
                "sketch_to_svg",
                "redrawn_clinical_svg",
                "none"
              ]
            },
            "svg_id": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "visual_goal": { "type": "string", "minLength": 1, "maxLength": 180 },
            "must_show_elements": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 80 }
            },
            "labels": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["zh", "en", "role"],
                "properties": {
                  "zh": { "type": "string", "minLength": 1, "maxLength": 24 },
                  "en": { "type": "string", "minLength": 1, "maxLength": 36 },
                  "role": {
                    "type": "string",
                    "enum": ["primary", "accent_red", "highlight_yellow", "muted"]
                  }
                }
              }
            },
            "semantic_color_plan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["black_primary", "red_accent", "yellow_highlight"],
              "properties": {
                "black_primary": { "type": "string", "maxLength": 160 },
                "red_accent": { "type": "string", "maxLength": 160 },
                "yellow_highlight": { "type": "string", "maxLength": 160 }
              }
            },
            "medical_accuracy_checks": {
              "type": "array",
              "minItems": 0,
              "maxItems": 4,
              "items": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "identifier",
              "reading_scope",
              "supporting_quote",
              "verified_by_human"
            ],
            "properties": {
              "source": { "type": "string", "minLength": 3, "maxLength": 160 },
              "identifier": { "type": "string", "minLength": 2, "maxLength": 80 },
              "reading_scope": {
                "type": "string",
                "enum": [
                  "full_text",
                  "textbook_chapter",
                  "guideline",
                  "abstract_only",
                  "local_note"
                ]
              },
              "supporting_quote": { "type": "string", "minLength": 5, "maxLength": 500 },
              "verified_by_human": { "type": "boolean" }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "golden_prototype_candidate", "uncertainties"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["draft", "audited", "approved"]
            },
            "golden_prototype_candidate": { "type": "boolean" },
            "uncertainties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 240 }
            }
          }
        }
      }
    },
    "localized_content_zh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kicker",
        "title",
        "core_insight",
        "bullets",
        "pearl_or_pitfall",
        "quadrant_summary"
      ],
      "properties": {
        "kicker": { "type": "string", "minLength": 1, "maxLength": 10 },
        "title": { "type": "string", "minLength": 2, "maxLength": 14 },
        "core_insight": { "type": "string", "minLength": 6, "maxLength": 38 },
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 6 },
              "text": { "type": "string", "minLength": 4, "maxLength": 28 }
            }
          }
        },
        "key_metrics": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 14 },
              "value": { "type": "string", "minLength": 1, "maxLength": 18 }
            }
          }
        },
        "pearl_or_pitfall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "type": "string", "enum": ["pearl", "pitfall"] },
            "text": { "type": "string", "minLength": 4, "maxLength": 36 }
          }
        },
        "quadrant_summary": { "type": "string", "minLength": 4, "maxLength": 22 },
        "expanded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clinical_context", "reference_note"],
          "properties": {
            "clinical_context": { "type": "string", "minLength": 1, "maxLength": 75 },
            "mini_table": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headers", "rows"],
              "properties": {
                "headers": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": { "type": "string", "maxLength": 16 }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": { "type": "string", "maxLength": 24 }
                  }
                }
              }
            },
            "reference_note": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        }
      }
    },
    "localized_content_en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kicker",
        "title",
        "core_insight",
        "bullets",
        "pearl_or_pitfall",
        "quadrant_summary"
      ],
      "properties": {
        "kicker": { "type": "string", "minLength": 1, "maxLength": 24 },
        "title": { "type": "string", "minLength": 2, "maxLength": 36 },
        "core_insight": { "type": "string", "minLength": 8, "maxLength": 95 },
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 16 },
              "text": { "type": "string", "minLength": 6, "maxLength": 72 }
            }
          }
        },
        "key_metrics": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 22 },
              "value": { "type": "string", "minLength": 1, "maxLength": 24 }
            }
          }
        },
        "pearl_or_pitfall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {
            "kind": { "type": "string", "enum": ["pearl", "pitfall"] },
            "text": { "type": "string", "minLength": 6, "maxLength": 90 }
          }
        },
        "quadrant_summary": { "type": "string", "minLength": 4, "maxLength": 55 },
        "expanded": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clinical_context", "reference_note"],
          "properties": {
            "clinical_context": { "type": "string", "minLength": 1, "maxLength": 180 },
            "mini_table": {
              "type": "object",
              "additionalProperties": false,
              "required": ["headers", "rows"],
              "properties": {
                "headers": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": { "type": "string", "maxLength": 24 }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": { "type": "string", "maxLength": 36 }
                  }
                }
              }
            },
            "reference_note": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        }
      }
    }
  }
}
