      "content": {
        "zh": {
          "kicker": "传导解剖",
          "title": "Koch三角怎么找",
          "core_insight": "从右房腔认出三条边，就能找到房室传导轴邻域。",
          "bullets": [
            {
              "label": "两条侧边",
              "text": "沿Todaro腱与三尖瓣隔瓣的附着线。"
            },
            {
              "label": "找底部",
              "text": "冠状窦口标出三角底部。"
            },
            {
              "label": "找尖端",
              "text": "两条侧边汇向膜部室间隔。"
            }
          ],
          "key_metrics": [],
          "pearl_or_pitfall": {
            "kind": "pitfall",
            "text": "致密房室结和His的位置随个体变化。"
          },
          "quadrant_summary": "右房三地标围出Koch三角",
          "expanded": {
            "clinical_context": "三角尖附近的三维传导轴与膜部室间隔相邻。His电位的记录区与三角尖的相对位置有变异。",
            "reference_note": "Cabrera 2020 Results及图3",
            "mini_table": {
              "headers": [
                "解剖地标",
                "三角位置",
                "定位作用"
              ],
              "rows": [
                [
                  "Todaro腱",
                  "后上侧边",
                  "纤维嵴收向三角尖"
                ],
                [
                  "隔瓣附着线",
                  "前下侧边",
                  "分隔右房与心室侧"
                ],
                [
                  "冠状窦口",
                  "三角底部",
                  "标定下界与慢径邻域"
                ]
              ]
            }
          }
        }
      },
      "layout": {
        "preferred_template": "split_left",
        "diagram_aspect_ratio": "square_1_1",
        "text_density": "compact"
